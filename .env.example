# NagarSetu environment configuration
# Copy this file to .env before enabling optional external services.
# Never commit your real .env file or real API credentials.

# Local database location is controlled by CIVICLENS_DATA_DIR; default is ./data.
# Optional external analysis provider. Without credentials it remains unavailable.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# -----------------------------
# Frontend / CORS
# -----------------------------
# Add your frontend origin(s), separated by commas if supported by your deployment.
FRONTEND_ORIGIN=http://127.0.0.1:5500

# -----------------------------
# Demo / development
# -----------------------------
# Enable only for local demos: mock phone OTP and demo admin access are not production auth.
DEMO_MODE=false
